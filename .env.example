# Copy to .env.local. Only needed to generate new media; the site itself runs without any keys.

# Cloudflare Workers AI (free tier) for FLUX.2 klein image generation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Free Hugging Face token, for the Wan 2.2 hero clip on the public Space.
HF_TOKEN=

# Live address, so Open Graph and canonical URLs are absolute.
NEXT_PUBLIC_SITE_URL=
